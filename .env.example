# =============================================================================
# BetPoly — configuración de ejemplo. Copia a `.env` y ajusta.
# Ningún valor de aquí es una clave privada: el backend nunca firma por ti.
# =============================================================================

# --- Telegram ----------------------------------------------------------------
BOT_TOKEN=123456:ABC-DEF...
# IDs de Telegram con permisos de administración (separados por coma)
ADMIN_IDS=123456789

# --- Persistencia ------------------------------------------------------------
DATABASE_PATH=betpoly.db
TIMEZONE=UTC
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Modo de operación -------------------------------------------------------
# points  -> solo puntos virtuales (sandbox, sin blockchain)
# escrow  -> solo TON real en el contrato escrow
# hybrid  -> ambos (por defecto)
BET_MODE=hybrid

# --- Economía de puntos (solo modo points) -----------------------------------
STARTING_POINTS=1000
MIN_BET_POINTS=10
MAX_BET_POINTS=1000000
HOUSE_RAKE_BPS=0
REMINDER_HOURS_BEFORE=24

# --- Contrato escrow ---------------------------------------------------------
# Dirección del contrato desplegado (contracts/escrow.fc), formato EQ... / 0:...
ESCROW_ADDRESS=
# Dirección del admin del contrato (firma resolve/cancel/pausa/comisión/retiro).
# El backend la usa para avisar si tu wallet vinculada no es la administradora;
# opcional, pero sin ella no puede comprobarlo.
ESCROW_ADMIN_ADDRESS=
# Apuesta mínima aceptada por el contrato, en nanoTON (0.1 TON)
MIN_STAKE_NANO=100000000
MAX_OPTIONS=8

# --- TON Connect / ton_proof -------------------------------------------------
PUBLIC_BASE_URL=https://betpoly.example.com
# Dominio que la wallet debe firmar en ton_proof. Si se omite, se usa el host
# de PUBLIC_BASE_URL.
TON_PROOF_DOMAIN=
# Ventana de validez de la prueba, en segundos
TON_PROOF_MAX_AGE=600
# Clave para firmar las sesiones HTTP (obligatoria en producción)
SECRET_KEY=

# --- Indexer (solo lectura) --------------------------------------------------
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL=20
INDEXER_BATCH=50
# mainnet | testnet
TON_NETWORK=mainnet
TON_API_URL=https://toncenter.com/api/v2
# API key de toncenter (recomendada: sin ella hay un límite muy bajo)
TON_API_KEY=
# Endpoint que devuelve la clave pública de una wallet no desplegada (opcional)
TON_PUBLIC_KEY_API=

# --- Mini App -----------------------------------------------------------------
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Permite abrir la Mini App sin Telegram (solo desarrollo; nunca en producción)
ALLOW_DEV_SESSION=false
APP_TITLE=BetPoly
SUPPORT_URL=
# Orígenes que pueden embeber la Mini App (CSP frame-ancestors)
FRAME_ANCESTORS='self' https://*.telegram.org https://web.telegram.org https://*.e2b.app

# --- Proxy inverso (IP real para los límites de tasa) -------------------------
# Solo se honra X-Forwarded-For si TRUST_PROXY=true Y la conexión viene de una
# de estas redes. Con TRUST_PROXY=false la cabecera se ignora (recomendado si
# el proceso escucha directo en Internet).
TRUST_PROXY=false
# Lista de CIDR separada por comas, p. ej. 127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXIES=
